  "document_lifecycle": {
    "statuses": {
      "draft": {
        "description": "Work in progress, not yet published",
        "searchable": false,
        "visible_to": ["owner", "admin"]
      },
      "active": {
        "description": "Current, published document",
        "searchable": true,
        "visible_to": "per_rbac_rules"
      },
      "deprecated": {
        "description": "Outdated but retained for reference",
        "searchable": true,
        "visible_to": ["sre", "manager", "admin"],
        "notes": "Hidden from most users to avoid outdated information"
      },
      "archived": {
        "description": "Retained for compliance, not searchable",
        "searchable": false,
        "visible_to": ["admin"]
      }
    },
    "transitions": [
      {"from": "draft", "to": "active", "action": "publish"},
      {"from": "active", "to": "deprecated", "action": "deprecate"},
      {"from": "deprecated", "to": "archived", "action": "archive"},
      {"from": "deprecated", "to": "active", "action": "restore"}
    ]
  },

  "versioning": {
    "strategy": "semantic_versioning",
    "format": "major.minor.patch",
    "rules": {
      "major": "Breaking changes or complete rewrites",
      "minor": "New sections or significant updates",
      "patch": "Typo fixes, clarifications, minor edits"
    },
    "retention": {
      "keep_versions": 5,
      "notes": "Keep last 5 versions for audit trail"
    }
  },

  "metadata": {
    "version": "1.0.0",
