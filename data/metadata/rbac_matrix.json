  "qdrant_implementation_example": {
    "description": "Example Qdrant filter for Engineer role querying API docs",
    "filter": {
      "must": [
        {
          "key": "status",
          "match": {
            "value": "active"
          }
        }
      ],
      "should": [
        {
          "key": "access_level",
          "match": {
            "value": "public"
          }
        },
        {
          "key": "allowed_roles",
          "match": {
            "any": ["engineer"]
          }
        },
        {
          "key": "allowed_departments",
          "match": {
            "any": ["engineering", "sre"]
          }
        }
      ],
      "min_should_match": 1
    }
  },

  "security_guarantees": {
    "unauthorized_leakage_rate": "0.0% (hard requirement)",
    "false_denial_rate": "<5% (target)",
    "prompt_injection_detection": ">95% (target)",
    "audit_coverage": "100% for confidential documents"
  },

