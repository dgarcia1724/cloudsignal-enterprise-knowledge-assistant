{
  "version": "1.0.0",
  "description": "Role-Based Access Control matrix for CloudSignal Knowledge Assistant. Defines which roles can access which document types and access levels.",
  "last_updated": "2025-01-01T00:00:00Z",

  "access_levels": {
    "public": {
      "description": "Accessible to all authenticated CloudSignal employees",
      "examples": ["Onboarding guides", "Company policies", "Public wikis"]
    },
    "internal": {
      "description": "Department-specific or role-specific access",
      "examples": ["Engineering docs", "Team postmortems", "Design documents"]
    },
    "restricted": {
      "description": "Senior roles, specific departments, or explicit grants required",
      "examples": ["SRE runbooks", "Product roadmap v2", "Security incidents"]
    },
    "confidential": {
      "description": "HR, Leadership, and Admin only - most sensitive data",
      "examples": ["Salary bands", "Performance reviews", "Financial projections"]
    }
  },

  "document_types": [
    "postmortem",
    "runbook",
    "design_doc",
    "api_spec",
    "architecture_doc",
    "deployment_guide",
    "coding_standards",
    "roadmap",
    "feature_spec",
    "customer_feedback",
    "competitive_analysis",
    "pricing_strategy",
    "hr_policy",
    "benefits_guide",
    "salary_bands",
    "performance_review",
    "onboarding_guide",
    "security_incident",
    "financial_report",
    "board_deck"
