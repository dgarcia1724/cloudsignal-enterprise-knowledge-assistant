  "enforcement_rules": {
    "priority_order": [
      "1. Explicit denials (denied_users field) - highest priority",
      "2. Explicit grants (granted_users field)",
      "3. Role-based access (allowed_roles field)",
      "4. Department-based access (allowed_departments field)",
      "5. Public documents (access_level = public) - lowest priority"
    ],
    "qdrant_filter_strategy": "Pre-filter vectors BEFORE search using Filter.must and Filter.should conditions",
    "audit_logging": {
      "log_all_confidential_access": true,
      "log_security_violations": true,
      "log_admin_actions": true
    },
    "special_cases": {
      "deprecated_documents": {
        "default": "hidden from search",
        "sre_can_access": true,
        "manager_can_access": true,
        "others": false
      },
      "manager_scoping": {
        "performance_reviews": "ONLY direct reports",
        "team_documents": "ONLY team members' documents",
        "cross_department": "Based on manager's department"
      },
      "temporal_filtering": {
        "available_from": "Filter documents not yet available (embargo)",
        "available_until": "Filter documents past expiration"
      }
    }
  },

